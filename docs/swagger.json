{
    "swagger": "2.0",
    "info": {
        "description": "Dokumentasi API Internal untuk Sistem Inventory, Nota, dan Kas.",
        "title": "Tiara Bakery Master API",
        "contact": {
            "name": "Aristo Budiman"
        },
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/",
    "paths": {
        "/login": {
            "post": {
                "description": "Endpoint publik untuk mendapatkan JWT Token berdasarkan kredensial Superadmin atau Sales.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Autentikasi User (Login)",
                "parameters": [
                    {
                        "description": "Format JSON dengan key: username, password",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Login sukses beserta token",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Username atau Password salah",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Masukkan token dengan format: \"Bearer {token_jwt}\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}